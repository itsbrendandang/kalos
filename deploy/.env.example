# kalos deployment environment - copy to `deploy/.env` and fill in.
# `.env` itself must NEVER be committed. This is a TEMPLATE with placeholder
# values only; every line below either does nothing on its own (a real
# secret still has to replace the placeholder) or is a REQUIRED value the
# stack will not start correctly without.
#
# compose.yaml reads this file automatically because it is named
# `.env` and sits next to the compose file - no `--env-file` flag needed as
# long as you run `docker compose` FROM the `deploy/` directory (or pass
# `-f deploy/compose.yaml` from the repo root, which docker compose
# also resolves `.env` relative to correctly).
#
# Every variable that configures the running containers is listed here, not
# hardcoded in compose.yaml, per this deploy pack's one hard rule:
# secrets and environment-specific config live in `.env`, never in a
# committed file.

# ---------------------------------------------------------------------------
# Security (src/kalos/portal/auth.py, src/kalos/portal/config.py) - REQUIRED
# ---------------------------------------------------------------------------
# These three exist because the engine is bound 0.0.0.0 in this compose
# stack, so kalos-web's server-side proxy can reach it over the compose
# network - and the engine sees that proxy as a remote peer (see
# compose.yaml's header comment). src/kalos/portal/config.py's
# `assert_safe_exposure` REFUSES to start uvicorn on a non-loopback bind
# unless KALOS_AUTH_TOKENS[_FILE] resolves to at least one real token AND
# KALOS_ANON_SALT is set. Leave either placeholder below unfilled (or
# unset) and `docker compose up engine` will exit non-zero with the exact
# reason on stderr - `docker compose logs engine` - rather than serving
# open. That refusal is the guard working correctly, not a deploy bug to
# work around; fix the value, don't bypass the check.

# REQUIRED. Inline JSON array of provisioned bearer tokens
# (src/kalos/portal/auth.py's `Authenticator`). Tokens are hashed SHA-256 and
# compared with `hmac.compare_digest` - only the hash lives in this file,
# never the plaintext token itself, so this file is safe to hand to an
# operator without also handing them a live credential.
#
# Generate a token and its hash together, e.g.:
#   python3 -c "import secrets, hashlib; t = secrets.token_urlsafe(32); \
#     print('token (give to the caller):', t); \
#     print('token_sha256 (put below):', hashlib.sha256(t.encode()).hexdigest())"
#
# `subject` is a human-readable label (who/what this token identifies, e.g.
# "kalos-web-service" or an operator's name), `tenant` is the tenant this
# principal's data is scoped to ("default" unless you have a reason for
# more than one), `scopes` is a subset of ["read", "write", "admin"] -
# "admin" can only be granted via a real token, never in open mode.
KALOS_AUTH_TOKENS=[{"token_sha256":"REPLACE_ME_WITH_A_REAL_SHA256_HASH","subject":"REPLACE_ME","tenant":"default","scopes":["read","write"]}]

# The PLAINTEXT token kalos-web's server sends to the engine (compose `web`
# service: `Authorization: Bearer $KALOS_ENGINE_TOKEN` on every proxied
# /api/engine/* call). Mint it with the snippet above, put its sha256 in a
# KALOS_AUTH_TOKENS entry (subject e.g. "kalos-web-service"), and the
# plaintext here. Server-only - never NEXT_PUBLIC_, never in the client bundle.
# Left as the placeholder, every proxied call is refused with 401. See
# RUNBOOK.md, "Security checklist".
KALOS_ENGINE_TOKEN=REPLACE_ME_WITH_THE_PLAINTEXT_WEB_SERVICE_TOKEN

# REQUIRED. Seeds the identity-pseudonymization used when anonymizing data
# for output (src/kalos/data/anonymizer.py, `salt_configured()`). Unset, it
# falls back to a published dev salt that is dictionary-attackable - fine
# for a bench machine, not for anything whose anonymized output leaves it.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KALOS_ANON_SALT=REPLACE_ME_WITH_A_RANDOM_SECRET

# REQUIRED. Comma-separated absolute origins allowed to make CORS requests
# to the engine (src/kalos/portal/config.py's `cors_origins()`). Must include
# the ORIGIN the browser actually loads kalos-web from - e.g. if kalos-web
# is reachable at http://kalos.example.com:3000, that exact scheme+host+port
# goes here. Unset, the engine falls back to its dev/pilot default
# (http://localhost / http://127.0.0.1, any port, credentials disabled),
# which a deployed kalos-web is almost never running on, so every browser
# call from it will be rejected by CORS - a failure that shows up
# immediately in the browser console, not silently.
KALOS_CORS_ORIGINS=http://REPLACE_ME_WITH_YOUR_WEB_HOST:3000

# ---------------------------------------------------------------------------
# kalos-web build config - optional
# ---------------------------------------------------------------------------
# DEV ESCAPE HATCH ONLY - leave unset. By default the browser calls kalos-web's
# same-origin /api/engine/* and kalos-web's server proxies to the engine with
# KALOS_ENGINE_TOKEN (above). Setting this bakes a direct engine URL into the
# client bundle at IMAGE BUILD time and forces the old direct-browser mode,
# which also needs the engine's port re-published and an open dev engine
# (RUNBOOK.md, "Security checklist"). Changing it requires rebuilding the web
# image.
# NEXT_PUBLIC_API_URL=

# Web proxy timeout for engine calls, in milliseconds. Default (unset or
# empty): 120000 - sized for a cold containerized GP fit; the original 30s
# guess returned 502 mid-analysis on the first real deployment.
# KALOS_ENGINE_TIMEOUT_MS=120000

# Optional. "true"/"1" enables kalos-web's DEMO_MODE badge/mock-data path
# (kalos-web's own honesty-pattern gate). Leave unset for a real deployment
# wired to a live engine - this stack always is.
# NEXT_PUBLIC_DEMO_MODE=

# ---------------------------------------------------------------------------
# Host port - optional. Only `web` publishes one; the engine is reachable
# only over the compose network.
# ---------------------------------------------------------------------------
# KALOS_WEB_PORT=3000

# ---------------------------------------------------------------------------
# Backup sidecar - optional, sane defaults
# ---------------------------------------------------------------------------
# BACKUP_KEEP_DAYS=7
# BACKUP_INTERVAL_SECONDS=86400

# ---------------------------------------------------------------------------
# Image tag - optional
# ---------------------------------------------------------------------------
# Tag applied to the three images this compose file builds
# (kalos-engine/kalos-web/kalos-backup:$KALOS_IMAGE_TAG). Useful for
# upgrade/rollback (RUNBOOK.md) - build a new tag, verify, then flip which
# tag is running rather than overwriting `:local` in place.
# KALOS_IMAGE_TAG=local

# ---------------------------------------------------------------------------
# Optional external-provider credentials (src/kalos/providers/) - all
# keyless-by-default; the engine works fully offline without any of these.
# See the repo-root .env.example (../.env.example) for the complete list and
# what each one unlocks - not duplicated here to avoid the two files drifting
# out of sync.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# KALOS_LLM_PROVIDER=typesafe
# TYPESAFE_API_KEY=
# KALOS_TYPESAFE_MODEL=
# KALOS_TYPESAFE_MIN_CONFIDENCE=
# NVIDIA_API_KEY=
# HF_TOKEN=
# BENCHLING_API_KEY=
# BENCHLING_TENANT=
# KALOS_MAX_UPLOAD_MB=
# KALOS_MAX_FIT_ROWS=
# KALOS_TORCH_THREADS=
