// Development container for kalos: Python 3.12 with the engine, portal, dev
// tools, and the TypeSafe tier installed into .venv by scripts/setup-dev.sh
// (the same script a cloud environment or a laptop uses). The venv lives in a
// named volume, so rebuilding the container keeps the installed packages.
// The image (./Containerfile, the same naming as deploy/) carries tools only:
// uv, sqlite3, shellcheck. Production images are separate: see deploy/README.md.
{
  "name": "kalos",
  "build": {
    "dockerfile": "Containerfile",
    "context": "."
  },
  "mounts": [
    "source=kalos-venv,target=${containerWorkspaceFolder}/.venv,type=volume",
    "source=kalos-state,target=/home/vscode/.kalos,type=volume",
    "source=kalos-hf-cache,target=/home/vscode/.cache/huggingface,type=volume"
  ],
  "postCreateCommand": "sudo chown -R vscode:vscode .venv && bash scripts/setup-dev.sh",
  "containerEnv": {
    "VIRTUAL_ENV": "${containerWorkspaceFolder}/.venv",
    "KALOS_STATE_DIR": "/home/vscode/.kalos"
  },
  // PATH lives in remoteEnv, not containerEnv: ${containerEnv:PATH} is only
  // substituted for remoteEnv, and in containerEnv it would reach `docker run`
  // literally and wipe PATH. Keys stay on the host and are passed through,
  // never written into the image; all are optional (see .env.example).
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}",
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "TYPESAFE_API_KEY": "${localEnv:TYPESAFE_API_KEY}",
    "KALOS_LLM_PROVIDER": "${localEnv:KALOS_LLM_PROVIDER}"
  },
  "forwardPorts": [8050],
  "portsAttributes": {
    "8050": { "label": "kalos portal (python -m kalos.portal)" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.mypy-type-checker", "charliermarsh.ruff"],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true
      }
    }
  }
}
