# Kalos environment variable template.
#
# This is a TEMPLATE, not a real config file. Copy it to `.env` and fill in
# only what you need - every variable below has a safe default (or an
# explicit "unset means" behavior) and nothing here is required to run the
# engine or the portal. `.env` itself must NEVER be committed; `.gitignore`
# already excludes it (`.env`, `.env.*`, with `!.env.example` re-including
# this file).
#
# No key below unlocks new behavior by itself - every provider has a fully
# offline, keyless fallback today. See kalos/providers/ for the credential
# seam and GET /api/providers for live status.

# ---------------------------------------------------------------------------
# External providers (kalos/providers/) - all optional, all keyless-by-default
# ---------------------------------------------------------------------------

# Anthropic API key. Unlocks the LLM-assisted tier of kalos.normalize's
# column/unit mapping (tolerant of unusual headers). Unset: the deterministic
# offline synonym+units mapper (offline_plan) still runs - normalization
# works, just less tolerant of unusual headers.
# ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# Model used by the LLM tier of kalos.normalize, when ANTHROPIC_API_KEY is
# set. Default: claude-sonnet-5.
# KALOS_NORMALIZE_MODEL=claude-sonnet-5

# Max rows sampled per column when building the LLM normalization payload.
# Default: 5, clamped to [1, 20]. A non-integer value falls back to the
# default rather than raising.
# KALOS_NORMALIZE_MAX_SAMPLE=5

# NVIDIA API key for a future hosted BioNeMo endpoint (real ESM-2 protein
# embeddings). SLOT ONLY - there is no BioNeMo client in this codebase today.
# Unset: kalos.features.protein already runs real ESM-2 embeddings via the
# public, non-gated facebook/esm2_t6_8M_UR50D Hugging Face checkpoint, which
# needs no token; the lean k-mer embedder covers the fully offline case.
# NVIDIA_API_KEY=nvapi-REPLACE_ME

# Hugging Face token, only needed to pull a GATED HF model checkpoint (not
# the public ESM-2 checkpoint kalos uses today). Optional even when
# NVIDIA_API_KEY is set.
# HF_TOKEN=hf_REPLACE_ME

# Benchling API key. Unlocks pulling run metadata, registry entities, and
# ELN results directly from the LIMS. SLOT ONLY - no HTTP calls are
# implemented today. Requires BENCHLING_TENANT to also be set (Benchling is
# per-tenant). Unset: provenance columns (run id, operator, instrument, date)
# must be present in the uploaded sheet itself, or the validation gate warns.
# BENCHLING_API_KEY=REPLACE_ME

# Benchling tenant subdomain, e.g. "acme" for acme.benchling.com. Required
# alongside BENCHLING_API_KEY - a key without a tenant is useless.
# BENCHLING_TENANT=acme

# ---------------------------------------------------------------------------
# Security (kalos/portal/auth.py, kalos/portal/config.py)
# ---------------------------------------------------------------------------

# Path to a JSON file of provisioned bearer tokens (preferred over the inline
# form below - can be rotated without a process restart). Unset (and
# KALOS_AUTH_TOKENS also unset): the portal API is fully OPEN - every request
# gets an anonymous principal with read+write scope. Set either this or
# KALOS_AUTH_TOKENS to enforce authentication.
# KALOS_AUTH_TOKENS_FILE=/etc/kalos/tokens.json

# Inline JSON array of provisioned bearer tokens, as an alternative to
# KALOS_AUTH_TOKENS_FILE. Same open-mode behavior when unset.
# KALOS_AUTH_TOKENS=[{"token_sha256":"...","subject":"svc-ingest","tenant":"acme","scopes":["read","write"]}]

# Comma-separated list of allowed CORS origins (e.g.
# "https://app.acme.com,https://admin.acme.com"). Unset: falls back to the
# permissive localhost-only regex (dev/pilot default).
# KALOS_CORS_ORIGINS=https://app.acme.com

# Shared secret the runner adapter sends as its Authorization bearer token
# against the portal's /api/experiments/*/result endpoint (and the http
# backend adapter reads it as its own credential). KALOS_BACKEND_TOKEN is
# accepted as a fallback name for the same value. Unset: that endpoint
# effectively 404s (no token to match).
# KALOS_RUNNER_TOKEN=REPLACE_ME
# KALOS_BACKEND_TOKEN=REPLACE_ME

# ---------------------------------------------------------------------------
# Sizing knobs - all have working defaults
# ---------------------------------------------------------------------------

# Max upload size in MB accepted by the portal's upload endpoint. Default: 25.
# KALOS_MAX_UPLOAD_MB=25

# Max rows a GP fit will process in one upload (protects against silent,
# non-deterministic data loss on huge sheets). Default: 2000.
# KALOS_MAX_FIT_ROWS=2000

# Torch intra-op thread cap, so concurrent fits don't oversubscribe the CPU.
# Default: min(4, os.cpu_count()).
# KALOS_TORCH_THREADS=4

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Directory for portal state (per-tenant "latest analysis" cache, the
# campaign store, etc). Default: ~/.kalos.
# KALOS_STATE_DIR=/var/lib/kalos

# Salt used to hash client identity (campaign/lot) into stable, irreversible
# barcodes. Unset: falls back to a literal DEV salt with a logged warning -
# identity hashes are dictionary-attackable with the default salt, so
# production MUST set this.
# KALOS_ANON_SALT=REPLACE_ME

# ---------------------------------------------------------------------------
# Runner backend selection (kalos/runner/adapter.py)
# ---------------------------------------------------------------------------

# Which runner backend to use: "local" (default, in-process) or "http"
# (calls a remote portal over HTTP, using KALOS_BACKEND_URL +
# KALOS_RUNNER_TOKEN/KALOS_BACKEND_TOKEN above).
# KALOS_BACKEND=local

# Base URL of the remote portal, required when KALOS_BACKEND=http.
# KALOS_BACKEND_URL=https://kalos.internal.example.com
